{
  "version": "1.0.0",
  "description": "Complete inventory of placeholders used in templates",
  "last_updated": "2026-01-19",
  
  "global_placeholders": {
    "ProjectName": {
      "format": "PascalCase",
      "description": "Name of the project",
      "examples": ["OrderService", "CustomerApi", "InventoryWorker"],
      "used_in": [
        "build/Build.cs",
        "azure-pipelines.yml",
        "config/appsettings.json",
        "deployment/scripts/migrate-secrets.ps1"
      ],
      "validation": {
        "pattern": "^[A-Z][a-zA-Z0-9]*$",
        "min_length": 3,
        "max_length": 50
      }
    },
    
    "SolutionName": {
      "format": "PascalCase",
      "description": "Name of the .sln file (usually same as ProjectName)",
      "examples": ["OrderService", "MyCompanyErp"],
      "used_in": [
        "build/Build.cs",
        "azure-pipelines.yml"
      ],
      "default": "{ProjectName}",
      "validation": {
        "pattern": "^[A-Z][a-zA-Z0-9]*$"
      }
    },
    
    "Namespace": {
      "format": "Dot-separated PascalCase",
      "description": "Root namespace for the project",
      "examples": ["SnpsGroup.OrderService", "Company.Services.Customer"],
      "used_in": [
        "build/Build.cs",
        "src/**/*.cs"
      ],
      "default": "SnpsGroup.{ProjectName}",
      "validation": {
        "pattern": "^[A-Z][a-zA-Z0-9]+(\\.[A-Z][a-zA-Z0-9]+)*$"
      }
    }
  },
  
  "environment_specific_placeholders": {
    "Port": {
      "description": "HTTP port for the application",
      "type": "number",
      "values": {
        "development": 5000,
        "staging": 5001,
        "production": 5002
      },
      "used_in": [
        "build/Helpers/DeploymentHelper.cs",
        "deployment/docker/docker-compose.yml"
      ]
    },
    
    "ServiceName": {
      "description": "IIS AppPool or systemd service name",
      "type": "string",
      "template": "{ProjectName}{Environment}AppPool",
      "examples": {
        "development": "OrderServiceDevelopmentAppPool",
        "staging": "OrderServiceStagingAppPool",
        "production": "OrderServiceProductionAppPool"
      },
      "used_in": [
        "build/Helpers/DeploymentHelper.cs"
      ]
    },
    
    "DeploymentPath": {
      "description": "Physical path where application is deployed",
      "type": "string",
      "platforms": {
        "windows": {
          "template": "D:\\inetpub\\{project}-{env}",
          "examples": {
            "development": "D:\\inetpub\\orderservice-dev",
            "staging": "D:\\inetpub\\orderservice-staging",
            "production": "D:\\inetpub\\orderservice-prod"
          }
        },
        "linux": {
          "template": "/var/www/{project}-{env}",
          "examples": {
            "development": "/var/www/orderservice-dev",
            "staging": "/var/www/orderservice-staging",
            "production": "/var/www/orderservice-prod"
          }
        }
      },
      "used_in": [
        "build/Helpers/DeploymentHelper.cs"
      ],
      "override_env_var": "DEPLOYMENT_PATH_{ENVIRONMENT}"
    },
    
    "BaseUrl": {
      "description": "Base URL for the deployed application",
      "type": "string",
      "values": {
        "development": "http://localhost:{Port}",
        "staging": "https://api-staging.snpsgroup.com",
        "production": "https://api.snpsgroup.com"
      },
      "used_in": [
        "build/Helpers/HealthCheckHelper.cs",
        "config/appsettings.{Environment}.json"
      ],
      "override_env_var": "BASE_URL_{ENVIRONMENT}"
    }
  },
  
  "configuration_tokens": {
    "description": "Tokens in config files that are replaced with secrets from OpenBao",
    "format": "#{kebab-case}",
    "env_var_format": "SECRET_{SCREAMING_SNAKE_CASE}",
    
    "common_tokens": [
      {
        "token": "#{database-connection-string}",
        "env_var": "SECRET_DATABASE_CONNECTION_STRING",
        "description": "Connection string for primary database",
        "example_value": "Server=localhost;Database=MyDb;User ID=sa;Password=***;TrustServerCertificate=true",
        "required": true,
        "environments": ["development", "staging", "production"]
      },
      {
        "token": "#{oauth-client-id}",
        "env_var": "SECRET_OAUTH_CLIENT_ID",
        "description": "OAuth 2.0 client identifier",
        "example_value": "erp-adaptive-v2-dev",
        "required": false,
        "environments": ["development", "staging", "production"]
      },
      {
        "token": "#{oauth-client-secret}",
        "env_var": "SECRET_OAUTH_CLIENT_SECRET",
        "description": "OAuth 2.0 client secret",
        "example_value": "aa459a56-5944-4540-8dea-bf359307d5d3",
        "required": false,
        "environments": ["development", "staging", "production"],
        "sensitive": true
      },
      {
        "token": "#{oauth-authority}",
        "env_var": "SECRET_OAUTH_AUTHORITY",
        "description": "OAuth 2.0 authority URL",
        "example_value": "https://oauth2.snpsgroup.com",
        "required": false,
        "environments": ["development", "staging", "production"]
      },
      {
        "token": "#{appinsights-instrumentation-key}",
        "env_var": "SECRET_APPINSIGHTS_INSTRUMENTATION_KEY",
        "description": "Azure Application Insights instrumentation key",
        "example_value": "869e7e98-ba28-4013-b13c-b783200ff733",
        "required": false,
        "environments": ["staging", "production"]
      },
      {
        "token": "#{redis-connection-string}",
        "env_var": "SECRET_REDIS_CONNECTION_STRING",
        "description": "Redis connection string",
        "example_value": "localhost:6379,password=***,defaultDatabase=1",
        "required": false,
        "environments": ["development", "staging", "production"]
      },
      {
        "token": "#{api-key}",
        "env_var": "SECRET_API_KEY",
        "description": "Generic API key for external services",
        "example_value": "sk_live_51H...",
        "required": false,
        "sensitive": true
      }
    ],
    
    "token_naming_rules": {
      "token_format": "Use kebab-case: #{database-connection-string}",
      "env_var_conversion": "Replace hyphens with underscores, uppercase, prefix with SECRET_",
      "examples": [
        {
          "token": "#{database-connection-string}",
          "env_var": "SECRET_DATABASE_CONNECTION_STRING"
        },
        {
          "token": "#{oauth-client-secret}",
          "env_var": "SECRET_OAUTH_CLIENT_SECRET"
        },
        {
          "token": "#{my-custom-api-key}",
          "env_var": "SECRET_MY_CUSTOM_API_KEY"
        }
      ]
    }
  },
  
  "openbao_paths": {
    "description": "Secret paths in OpenBao",
    "base_path": "/secret/data",
    "structure_template": "/{project-name}/{environment}",
    
    "examples": {
      "project": "orderservice",
      "paths": {
        "development": "/secret/data/orderservice/development",
        "staging": "/secret/data/orderservice/staging",
        "production": "/secret/data/orderservice/production",
        "shared": "/secret/data/orderservice/shared"
      }
    },
    
    "path_conventions": {
      "project_name": "Lowercase, hyphenated",
      "environment": "Lowercase (development, staging, production)",
      "shared_secrets": "Use /shared for secrets common across environments (e.g., NuGet API key)"
    }
  },
  
  "azure_devops_names": {
    "variable_group_template": "{ProjectName}-{Environment}-Secrets",
    "environment_template": "{ProjectName}-{Environment}",
    "pipeline_template": "{ProjectName} CI/CD",
    
    "examples": {
      "project": "OrderService",
      "variable_groups": [
        "OrderService-Development-Secrets",
        "OrderService-Staging-Secrets",
        "OrderService-Production-Secrets"
      ],
      "environments": [
        "OrderService-Development",
        "OrderService-Staging",
        "OrderService-Production"
      ],
      "pipeline": "OrderService CI/CD"
    }
  },
  
  "substitution_script": {
    "powershell": "DevOpsAgent/scripts/init-project.ps1",
    "method": "String replacement using -replace operator",
    "safe_mode": true,
    "excluded_extensions": [".dll", ".exe", ".zip", ".bin", ".dat"],
    "dry_run_available": true
  },
  
  "validation": {
    "pre_substitution": [
      "Verify all required placeholders are defined",
      "Validate format of placeholder values",
      "Check for placeholder naming conflicts"
    ],
    "post_substitution": [
      "Scan files for unreplaced placeholders: grep -r '\\{ProjectName\\}'",
      "Verify no placeholders in .gitignore'd files",
      "Test compilation: dotnet build"
    ],
    "tools": [
      "DevOpsAgent/scripts/validate-setup.ps1",
      "DevOpsAgent/tools/token-validator.cs"
    ]
  },
  
  "custom_placeholders": {
    "description": "Projects can define custom placeholders",
    "how_to_add": [
      "1. Add placeholder definition to this file",
      "2. Update templates to use new placeholder",
      "3. Update init-project.ps1 to substitute new placeholder",
      "4. Document in project DEPLOYMENT.md"
    ],
    "example": {
      "placeholder": "{DatabaseServer}",
      "description": "Database server hostname",
      "values": {
        "development": "localhost",
        "staging": "staging-sql.snpsgroup.local",
        "production": "prod-sql.snpsgroup.local"
      }
    }
  }
}
